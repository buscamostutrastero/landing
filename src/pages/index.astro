---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { business } from '../lib/business';
import { storageSizes, faqs, title, description, updatedLabel, illustrationNotice } from '../lib/storage-content';
import { ArrowDown, ArrowUpRight, CheckCircle2, ChevronDown, MapPin } from 'lucide-react';
import { HugeiconsIcon } from '@hugeicons/react';
import { Calendar01Icon, Home04Icon, PackageMoving01Icon, PackageSearch01Icon, Store01Icon, TaskAdd02Icon } from '@hugeicons/core-free-icons';

const businessId = `${business.url}/#empresa`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SelfStorage',
      '@id': businessId,
      name: business.name,
      url: `${business.url}/`,
      description,
      email: business.email,
      logo: `${business.url}/brand/logo.webp`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.streetAddress,
        addressLocality: business.locality,
        addressRegion: business.region,
        addressCountry: business.country,
      },
      areaServed: { '@type': 'Place', name: 'Casablanca, Zaragoza' },
      contactPoint: {
        '@type': 'ContactPoint',
        email: business.email,
        contactType: 'Información sobre trasteros y próxima apertura',
        availableLanguage: 'es',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${business.url}/#sitio`,
      url: `${business.url}/`,
      name: business.name,
      inLanguage: 'es-ES',
      publisher: { '@id': businessId },
    },
    {
      '@type': ['WebPage', 'FAQPage'],
      '@id': `${business.url}/#pagina`,
      url: `${business.url}/`,
      name: title,
      description,
      inLanguage: 'es-ES',
      dateModified: business.updatedAt,
      isPartOf: { '@id': `${business.url}/#sitio` },
      about: { '@id': businessId },
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      })),
    },
    {
      '@type': 'ItemList',
      '@id': `${business.url}/#tamanos`,
      name: 'Tamaños de trastero que se ofrecerán en la próxima apertura',
      numberOfItems: storageSizes.length,
      itemListElement: storageSizes.map(({ size }, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Service',
          name: `Trastero de ${size} m² en Casablanca, Zaragoza`,
          serviceType: 'Alquiler de trasteros',
          description: `Trastero de ${size} m² que se ofrecerá cuando abra Buscamos tu Trastero en Calle de las Rosas 16, Casablanca, Zaragoza. Próxima apertura; tarifas y fecha aún no publicadas.`,
          provider: { '@id': businessId },
          url: `${business.url}/#trasteros`,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Seo {title} {description} {structuredData} markdownPath="/index.md" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="site-shell">
      <div class="topbar">
        <div class="container topbar-inner">
          <MapPin aria-hidden="true" size={15} strokeWidth={2} />
          <span>Próxima apertura · Casablanca, Zaragoza</span>
        </div>
      </div>

      <header class="site-header">
        <div class="container nav">
          <a class="brand" href="#inicio" aria-label="Buscamos tu Trastero, inicio"><img src="/brand/logo.webp" width="1260" height="380" alt="Buscamos tu Trastero" /></a>
          <nav class="nav-links" aria-label="Navegación principal">
            <a href="#trasteros">Tamaños</a>
            <a href="#como-funciona">Cómo empezar</a>
            <a href="#ubicacion">Ubicación</a>
            <a href="#preguntas">Preguntas</a>
          </nav>
          <a class="button button-dark" href="/contacto/" aria-label="Me interesa un trastero"><span>Me interesa un trastero</span><ArrowUpRight aria-hidden="true" size={17} strokeWidth={2.25} /></a>
        </div>
      </header>

      <main id="contenido" tabindex="-1">
        <section class="hero" id="inicio">
          <div class="container hero-grid">
            <div class="hero-copy">
              <div class="eyebrow">Trasteros en Casablanca, Zaragoza · Próxima apertura</div>
              <h1 class="display"><span class="hero-heading-line">Has ordenado otra vez.</span> <span class="accent-heading hero-heading-line">Sigue sin caber una mierda.</span></h1>
              <p>Cambias las cajas de habitación. Empujas la bici contra la pared. Cierras el armario haciendo fuerza. Ya has hecho hueco demasiadas veces.</p>
              <p>Abrimos trasteros de 1 a 3,5 m² en Calle de las Rosas 16, Casablanca, Zaragoza. Para guardar lo que quieres conservar y dejar de vivir esquivándolo.</p>
              <div class="hero-actions">
                <a class="button button-primary" href="/contacto/"><span>Me interesa un trastero</span><span class="button-icon"><ArrowUpRight aria-hidden="true" size={18} strokeWidth={2.25} /></span></a>
                <a class="button button-ghost" href="#trasteros"><span>Ver los tamaños</span><span class="button-icon button-icon-ghost"><ArrowDown aria-hidden="true" size={18} strokeWidth={2.25} /></span></a>
              </div>
              <div class="hero-note"><span class="hero-note-icon"><MapPin aria-hidden="true" size={16} strokeWidth={2} /></span><span>Calle de las Rosas 16 · Zaragoza</span></div>
            </div>
            <div class="hero-media">
              <img src="/images/storage-hero.webp" width="1536" height="1024" alt="Trastero ordenado con cajas y espacio para guardar muebles" loading="eager" fetchpriority="high" />
              <div class="hero-tag"><span class="hero-tag-icon"><MapPin aria-hidden="true" size={20} strokeWidth={2.1} /></span><span class="hero-tag-copy"><strong>Casablanca, Zaragoza</strong><span>Próxima apertura</span></span></div>
            </div>
          </div>
        </section>

        <div class="proof-strip">
          <div class="container proof-items">
            <div class="proof-item"><CheckCircle2 aria-hidden="true" size={17} strokeWidth={2} /> Recupera tu habitación</div>
            <div class="proof-item"><CheckCircle2 aria-hidden="true" size={17} strokeWidth={2} /> Deja libre el pasillo</div>
            <div class="proof-item"><CheckCircle2 aria-hidden="true" size={17} strokeWidth={2} /> Conserva lo que quieres</div>
          </div>
        </div>

        <section class="section storage-section" id="trasteros" aria-labelledby="storage-heading">
          <div class="container">
            <div class="storage-heading">
              <div class="section-heading">
                <div class="eyebrow">De 1 a 3,5 m²</div>
                <h2 class="section-title" id="storage-heading">Trasteros de 1 a 3,5 m². ¿Qué sacarías de casa?</h2>
                <p>Desde las cajas del armario hasta lo que ocupa una habitación. Cuando abramos, ofreceremos todos estos tamaños de trastero.</p>
              </div>
              <span class="storage-opening"><HugeiconsIcon icon={Calendar01Icon} aria-hidden="true" size={18} strokeWidth={1.8} />Próxima apertura</span>
            </div>
            <div class="storage-grid">
              {storageSizes.map(({ size, image, title, description, alt }) => (
                <article class="storage-card">
                  <img src={`/images/sizes/${image}-800.webp`} srcset={`/images/sizes/${image}-480.webp 480w, /images/sizes/${image}-800.webp 800w`} sizes="(min-width: 1100px) 360px, (min-width: 768px) 45vw, calc(100vw - 40px)" width="800" height="800" alt={alt} loading="lazy" decoding="async" />
                  <div class="storage-card-copy">
                    <h3><span class="storage-size">{size} <span>m²</span></span><span class="storage-card-title">{title}</span></h3>
                    <p>{description}</p>
                  </div>
                </article>
              ))}
            </div>
            <p class="storage-caption">{illustrationNotice}</p>
            <div class="storage-help">
              <div><h3>¿No sabes cuántos metros necesitas?</h3><p>Cuéntanos qué quieres guardar. Te ayudamos a elegir el tamaño.</p></div>
              <a class="button button-dark" href="/contacto/"><span>Me interesa un trastero</span><ArrowUpRight aria-hidden="true" size={18} strokeWidth={2.25} /></a>
            </div>
          </div>
        </section>

        <section class="section" id="como-funciona">
          <div class="container split">
            <div class="media-card"><img src="/images/storage-organized.webp" width="1122" height="1402" alt="Cajas y objetos organizados dentro de un trastero" loading="lazy" /><span class="media-label">Que quepan tus cosas. Y tú.</span></div>
            <div class="copy-stack">
              <div class="eyebrow">Ordenar tiene un límite</div>
              <h2 class="section-title">Moverlo de sitio no hace que ocupe menos.</h2>
              <p>El domingo ordenas. El lunes vuelves a sacar la bici para llegar al armario. Y esa habitación que ibas a usar de despacho sigue llena de cajas. Tus cosas necesitan un sitio que no tengas que despejar cada dos días.</p>
              <div class="number-list" aria-label="Cómo contarnos lo que necesitas">
                <article class="number-item"><span class="number">01</span><span class="step-icon"><HugeiconsIcon icon={PackageSearch01Icon} aria-hidden="true" size={21} strokeWidth={1.8} /></span><div class="step-copy"><strong>Dinos qué no te cabe</strong><span>Cajas, una bici, el sofá de tu madre. Una lista aproximada nos vale.</span></div></article>
                <article class="number-item"><span class="number">02</span><span class="step-icon"><HugeiconsIcon icon={TaskAdd02Icon} aria-hidden="true" size={21} strokeWidth={1.8} /></span><div class="step-copy"><strong>Cuéntanos para cuándo</strong><span>Una mudanza en noviembre o un pasillo que ya no aguantas. Dinos tu plazo.</span></div></article>
                <article class="number-item"><span class="number">03</span><span class="step-icon"><HugeiconsIcon icon={Calendar01Icon} aria-hidden="true" size={21} strokeWidth={1.8} /></span><div class="step-copy"><strong>Déjanos cómo contactar</strong><span>Un teléfono para hablar de lo que necesitas. Sin contratar nada todavía.</span></div></article>
              </div>
            </div>
          </div>
        </section>

        <section class="section section-soft">
          <div class="container">
            <div class="section-heading"><div class="eyebrow">Lo que ya no cabe</div><h2 class="section-title">Todo tiene su sitio. Hasta que no lo tiene.</h2><p>Lo quieres conservar. Lo vas a necesitar. O aún no has decidido qué hacer con ello. Mientras tanto, te está comiendo la casa.</p></div>
            <div class="cards">
              <article class="card"><div class="card-icon"><HugeiconsIcon icon={Home04Icon} aria-hidden="true" size={25} strokeWidth={1.75} /></div><div><h3>La habitación de las cajas</h3><p>Iba a ser un despacho. O un cuarto para invitados. Ahora abres la puerta, miras las cajas y vuelves a cerrar. Esa habitación también la pagas.</p></div></article>
              <article class="card"><div class="card-icon"><HugeiconsIcon icon={PackageMoving01Icon} aria-hidden="true" size={25} strokeWidth={1.75} /></div><div><h3>La mudanza que no termina</h3><p>Tienes que vaciar el piso y todavía no puedes entrar en el siguiente. El sofá no se encoge. Y en casa de tus padres tampoco cabe.</p></div></article>
              <article class="card"><div class="card-icon"><HugeiconsIcon icon={Store01Icon} aria-hidden="true" size={25} strokeWidth={1.75} /></div><div><h3>El stock llega hasta el salón</h3><p>La mercancía en el pasillo. Las herramientas debajo de la mesa. Cada pedido trae otra caja. Tu negocio crece; tu casa sigue midiendo lo mismo.</p></div></article>
            </div>
          </div>
        </section>

        <section class="section location" id="ubicacion">
          <div class="container location-grid">
            <div>
              <div class="eyebrow">Aquí abrimos</div>
              <h2>Tus cosas, en Las Rosas 16. Tu casa, para ti.</h2>
              <p>Abrimos trasteros en Calle de las Rosas 16, en Casablanca, Zaragoza. Para esas cosas que quieres tener cerca, pero que no necesitas ver cada vez que cruzas el salón.</p>
              <address class="location-detail"><span class="pin"><MapPin aria-hidden="true" size={17} strokeWidth={2} /></span><span>Calle de las Rosas 16 · Casablanca, Zaragoza</span></address>
              <div class="location-image"><img src="/images/moving-boxes.webp" width="1448" height="1086" alt="Cajas preparadas para una mudanza" loading="lazy" /></div>
            </div>
            <div class="contact-card" id="contacto">
              <h3>Busca tu tamaño perfecto.</h3><p>Elige entre 1 y 3,5 m². Si no sabes cuánto espacio necesitas, te ayudamos a elegir.</p>
              <a class="button button-primary" href="/contacto/">Me interesa un trastero <ArrowUpRight aria-hidden="true" size={18} /></a>
              <p class="form-footnote">Elige tamaño y déjanos tus datos. Solicitar información no implica reservar ni pagar.</p>
            </div>
          </div>
        </section>

        <section class="section" id="preguntas">
          <div class="container">
            <div class="section-heading"><div class="eyebrow">Preguntas frecuentes</div><h2 class="section-title">Al grano: dónde, cuándo y cuánto.</h2><p class="information-updated">Información de apertura actualizada el <time datetime={business.updatedAt}>{updatedLabel}</time>.</p></div>
            <div class="faq-list">{faqs.map(([question, answer]) => <details><summary><span>{question}</span><ChevronDown className="faq-chevron" aria-hidden="true" size={20} strokeWidth={2} /></summary><p>{answer}</p></details>)}</div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <div class="container footer-main">
          <div><div class="footer-brand">Buscamos tu <span>Trastero</span></div><p class="footer-description">Abrimos en Casablanca. Para que vuelvas a tener sitio en casa.</p><a class="footer-contact" href={`mailto:${business.email}`}>{business.email}</a></div>
          <nav class="footer-nav" aria-label="Navegación del sitio"><strong>Explora</strong><a href="#trasteros">Tamaños de trastero</a><a href="#como-funciona">Cómo empezar</a><a href="#ubicacion">Ubicación</a><a href="#preguntas">Preguntas frecuentes</a></nav>
          <nav class="footer-nav" aria-label="Información legal"><strong>Legal</strong><a href="/aviso-legal/">Aviso legal</a><a href="/politica-privacidad/">Privacidad</a><a href="/politica-cookies/">Cookies</a></nav>
        </div>
        <div class="container footer-bottom"><span>© {new Date().getFullYear()} Buscamos tu Trastero</span><span>Todos los derechos reservados.</span></div>
      </footer>
    </div>
  </body>
</html>
