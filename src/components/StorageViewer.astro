---
import '../styles/storage-viewer.css';
import { viewerHeight, viewerUnits } from '../lib/storage-viewer-data';
import { ArrowUpRight, Box, Grid2X2, Minus, MoveHorizontal, Plus, RotateCcw, RotateCw, UserRound, X } from 'lucide-react';

const initial = viewerUnits[0]!;
---

<dialog id="storage-viewer" class="viewer" aria-labelledby="viewer-title" aria-describedby="viewer-notice" data-units={JSON.stringify(viewerUnits)} data-height={viewerHeight}>
  <div class="viewer-panel">
    <header class="viewer-header">
      <div>
        <p class="viewer-eyebrow">Recreación 3D</p>
        <h2 id="viewer-title" tabindex="-1">Trastero de {initial.size} m²</h2>
      </div>
      <button type="button" class="viewer-close" data-viewer-close aria-label="Cerrar"><X aria-hidden="true" size={18} strokeWidth={2.25} /><span>Cerrar</span></button>
    </header>

    <div class="viewer-stage" data-viewer-stage data-view="3d">
      <div class="viewer-canvas" data-viewer-canvas></div>
      <p class="viewer-loading" data-viewer-loading hidden><span aria-hidden="true"></span>Preparando la vista 3D…</p>
      <div class="viewer-fallback" data-viewer-fallback hidden>
        <img src={`/images/sizes/${initial.image}-480.webp`} width="480" height="480" alt="" data-viewer-fallback-image />
        <p>No se ha podido mostrar la vista 3D. Puedes consultar la ilustración de este tamaño o pedirnos información.</p>
      </div>
      <div class="viewer-controls" role="group" aria-label="Controles de la vista 3D" data-viewer-controls>
        <div class="viewer-views" role="group" aria-label="Punto de vista">
          <button type="button" data-viewer-action="reset" aria-pressed="true"><Box aria-hidden="true" size={17} /><span>3D</span></button>
          <button type="button" data-viewer-action="top" aria-pressed="false"><Grid2X2 aria-hidden="true" size={17} /><span>Desde arriba</span></button>
        </div>
        <label class="viewer-objects-toggle">
          <input type="checkbox" data-viewer-objects checked aria-describedby="viewer-objects-description" />
          <span>Mostrar objetos</span>
        </label>
        <p id="viewer-objects-description" class="sr-only">Ejemplo de organización con una estantería, cajas y una maleta. Los mismos objetos, con las mismas medidas, en todos los tamaños.</p>
        <div class="viewer-navigation" role="group" aria-label="Girar y ampliar">
        <button type="button" data-viewer-action="rotate-left" aria-label="Girar a la izquierda" title="Girar a la izquierda"><RotateCcw aria-hidden="true" size={18} /></button>
        <button type="button" data-viewer-action="rotate-right" aria-label="Girar a la derecha" title="Girar a la derecha"><RotateCw aria-hidden="true" size={18} /></button>
        <span class="viewer-control-divider" aria-hidden="true"></span>
        <button type="button" data-viewer-action="zoom-in" aria-label="Acercar" title="Acercar"><Plus aria-hidden="true" size={18} /></button>
        <button type="button" data-viewer-action="zoom-out" aria-label="Alejar" title="Alejar"><Minus aria-hidden="true" size={18} /></button>
        </div>
      </div>
      <p class="viewer-scale"><MoveHorizontal aria-hidden="true" size={16} /><span data-viewer-scale>Mismos objetos, misma escala</span></p>
      <p class="viewer-reference"><UserRound aria-hidden="true" size={18} /><span>Figura de referencia<strong>1,70 m</strong></span></p>
      <p class="viewer-hint" data-viewer-hint aria-hidden="true">Arrastra para girar · Pellizca para ampliar</p>
    </div>

    <footer class="viewer-footer">
      <fieldset class="viewer-sizes">
        <legend>Tamaño</legend>
        <div class="viewer-size-options">
          {viewerUnits.map(({ size }, index) => (
            <label class="viewer-size"><input type="radio" name="viewer-size" value={size} checked={index === 0} /><span>{size} m²</span></label>
          ))}
        </div>
      </fieldset>
      <p id="viewer-notice" class="viewer-notice">Recreación orientativa, con proporciones aproximadas. La estantería y los objetos son un ejemplo de organización.</p>
      <a class="button button-primary viewer-contact" href={`/contacto/?size=${encodeURIComponent(initial.size)}`} data-viewer-contact><span>Me interesa este tamaño</span><ArrowUpRight aria-hidden="true" size={18} strokeWidth={2.25} /></a>
    </footer>
  </div>
</dialog>
<script src="../scripts/storage-viewer.ts"></script>
